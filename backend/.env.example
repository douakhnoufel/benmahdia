# Copy to .env (never commit .env). Values here are for local development only.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://benmahdia:benmahdia@db:5432/benmahdia

# Long random strings, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`
JWT_SECRET=change-me-dev-only-jwt-secret-0000000000000000
OTP_SECRET=change-me-dev-only-otp-secret-0000000000000000

# "console" prints codes to the API log (development only; refused in production).
SMS_PROVIDER=console

# Comma-separated OAuth client IDs that may sign in. Empty = that provider is off.
GOOGLE_CLIENT_IDS=
# Apple: the iOS bundle ID (and Services ID for Android/web), comma-separated.
APPLE_CLIENT_IDS=
# For revoking Apple tokens when an account is deleted (from your Apple developer account).
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
DELETION_GRACE_DAYS=30

# Chargily Pay v2. Test mode: the /test/ URL and a test_sk_ key (no real money).
CHARGILY_API_URL=https://pay.chargily.net/test/api/v2
CHARGILY_SECRET_KEY=
# Where Chargily can reach this API (webhook + return pages), e.g. an ngrok URL.
PUBLIC_BASE_URL=http://localhost:8000
